{
  "name": "opencatalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "validate": "bun run scripts/validate-curated.ts",
    "validate:staging": "bun run scripts/validate-staging.ts",
    "enrich": "bun run scripts/enrich.ts",
    "promote": "bun run scripts/promote.ts",
    "add-entry": "bun run scripts/add-entry.ts",
    "sync-kv": "bun run scripts/sync-kv.ts",
    "build:api": "bun run scripts/build-api.ts",
    "test": "bun test tests/schema.test.ts",
    "test:e2e": "playwright test",
    "precommit": "biome check . && bun run validate && bun test"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0",
    "@orama/orama": "3.1.18",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.5",
    "@upstash/redis": "^1.38.0",
    "cmdk": "1.1.1",
    "lucide-react": "1.23.0",
    "motion": "12.42.2",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@ibm/plex-mono",
    "@ibm/plex-sans",
    "sharp"
  ]
}
